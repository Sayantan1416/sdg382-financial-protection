> --
. * 4. SENSITIVITY
. *----------------------------------------------------------------------------
> --
. * 4a. matching window (+/-0, 1, 2, 3 years)
. foreach k in 0 1 2 3 {
  2.     build_S `k' `L' `H'
  3.     tempfile Sk
  4.     save `Sk'
  5.     keep if !missing(cat10)
  6.     bysort iso3 (svy_year): keep if _n == _N
  7.     regress cat10 oop lngdp uhc i.reg, vce(robust)
  8.     putb `V' "win`k'.A" oop
  9.     use `Sk', clear
 10.     keep if !missing(cat10, fh_total)
 11.     bysort iso3 (svy_year): keep if _n == _N
 12.     keep if !missing(lngdp)
 13.     spearman fh_total lngdp
 14.     put `V' "win`k'.rho_new" r(rho)
 15.     spearman cat10 lngdp
 16.     put `V' "win`k'.rho_old" r(rho)
 17.     expand 2
 18.     bysort iso3: gen byte new = _n == 2
 19.     gen y = cond(new, fh_total, cat10)
 20.     regress y i.new##c.lngdp i.new##i.reg, vce(cluster cid)
 21.     put `V' "win`k'.diff_b" -_b[1.new#c.lngdp]
 22.     put `V' "win`k'.diff_p" 2*ttail(e(df_r), abs(_b[1.new#c.lngdp]/_se[1.n
> ew#c.lngdp]))
 23.     put `V' "win`k'.diff_n" e(N)/2
 24.     build_G `k' `L'
 25.     tempfile Gk
 26.     save `Gk'
 27.     foreach g in gap_q gap_old gap_rur {
 28.         use `Gk', clear
 29.         keep if !missing(`g')
 30.         bysort iso3 (svy_year): keep if _n == _N
 31.         regress `g' oop lngdp, vce(robust)
 32.         putb `V' "win`k'.`g'" oop
 33.         regress `g' oop lngdp pov_spl, vce(robust)
 34.         putb `V' "win`k'.`g'_pov" oop
 35.     }
 36. }
