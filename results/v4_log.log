. 
. * 4e. threshold reassessment on the 2025 indicator (pairs with controls)
. capture mata: mata drop supw()

. capture mata: mata drop wboot()

. mata:
------------------------------------------------- mata (type end to exit) -----
: real rowvector supw(real colvector y, real matrix X0, real colvector oop, rea
> l scalar minn)
> {
>     real scalar best, at, c, k, n, w
>     real colvector h, b, e
>     real matrix X, XXi, V
>     best = 0
>     at = .
>     n = rows(y)
>     for (c = 10; c <= 70; c++) {
>         h = (oop :- c) :* (oop :> c)
>         if (sum(h :> 0) < minn | sum(h :== 0) < minn) continue
>         X   = (X0, h)
>         XXi = invsym(cross(X, X))
>         b   = XXi * cross(X, y)
>         e   = y - X * b
>         k   = sum(diagonal(XXi) :!= 0)
>         V   = XXi * cross(X, e:^2, X) * XXi * (n / (n - k))
>         w   = b[cols(X)]^2 / V[cols(X), cols(X)]
>         if (w > best) {
>             best = w
>             at = c
>         }
>     }
>     return((best, at))
> }

: real scalar wboot(real colvector f, real colvector u, real matrix X0, real co
> lvector o, real scalar w0, real scalar reps)
> {
>     real scalar r, ex
>     real colvector ys
>     real rowvector rr
>     ex = 0
>     for (r = 1; r <= reps; r++) {
>         ys = f + u :* (2 * (runiform(rows(u), 1) :< 0.5) :- 1)
>         rr = supw(ys, X0, o, 8)
>         if (rr[1] >= w0) ex++
>     }
>     return(ex)
> }

: end
-------------------------------------------------------------------------------

. foreach spec in base pov {
  2.     use `S', clear
  3.     keep if !missing(fh_total)
  4.     bysort iso3 (svy_year): keep if _n == _N
  5.     local ctl "lngdp uhc"
  6.     if "`spec'" == "pov" local ctl "lngdp uhc pov_spl"
  7.     keep if !missing(fh_total, oop, reg) & !missing(`=subinstr("`ctl'", " 
> ", ",", .)')
  8.     count
  9.     put `V' "thr_new.`spec'.n" r(N)
 10.     quietly tab reg, gen(rd_)
 11.     drop rd_1
 12.     gen byte cons = 1
 13.     mata: y = st_data(., "fh_total"); X0 = st_data(., "oop `ctl' rd_* cons
> "); o = st_data(., "oop")
 14.     mata: r0 = supw(y, X0, o, 8); st_numscalar("W0", r0[1]); st_numscalar(
> "at0", r0[2])
 15.     put `V' "thr_new.`spec'.supW" W0
 16.     put `V' "thr_new.`spec'.at" at0
 17.     quietly regress fh_total oop `ctl' i.reg
 18.     predict double fit, xb
 19.     predict double res, residuals
 20.     mata: st_numscalar("exceed", wboot(st_data(., "fit"), st_data(., "res"
> ), X0, o, st_numscalar("W0"), 499))
 21.     put `V' "thr_new.`spec'.p_boot" exceed/499
 22.     gen oop2 = oop^2
 23.     regress fh_total oop oop2 `ctl' i.reg, vce(robust)
 24.     putb `V' "thr_new.`spec'.quad" oop2
 25.     capture drop h
 26.     gen h = max(oop - 20, 0)
 27.     regress fh_total oop h `ctl' i.reg, vce(robust)
 28.     putb `V' "thr_new.`spec'.h20" h
 29. }
