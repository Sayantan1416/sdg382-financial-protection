. * --- group gaps ---
. foreach g in gap_q gap_old gap_rur {
  2.     use `G', clear
  3.     keep if !missing(`g')
  4.     bysort iso3 (svy_year): keep if _n == _N
  5.     keep if !missing(`g', oop, lngdp)
  6.     regress `g' oop lngdp
  7.     predict double cd, cooksd
  8.     regress `g' oop lngdp if cd <= 4/e(N), vce(robust)
  9.     putb `V' "alt.`g'.cook" oop
 10.     qreg `g' oop lngdp, vce(robust)
 11.     putb `V' "alt.`g'.qreg" oop
 12.     * ratio instead of difference (relative gap)
.     if "`g'" == "gap_q"   gen double rel = ln(q1/q5)     if q5 > 0 & q1 > 0
 13.     if "`g'" == "gap_old" gen double rel = ln(old/adults) if adults > 0 & 
> old > 0
 14.     if "`g'" == "gap_rur" gen double rel = ln(rur/urb)   if urb > 0 & rur 
> > 0
 15.     regress rel oop lngdp, vce(robust)
 16.     putb `V' "alt.`g'.ln_ratio" oop
 17. }
