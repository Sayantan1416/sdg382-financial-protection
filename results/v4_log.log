. * national components of the 2025 indicator (latest survey since 2005)
. foreach v in fh_total fh_large fh_impov cat10 {
  2.     use `S', clear
  3.     keep if !missing(`v')
  4.     bysort iso3 (svy_year): keep if _n == _N
  5.     regress `v' oop lngdp uhc i.reg, vce(robust)
  6.     putb `V' "comp.`v'.base" oop
  7.     regress `v' oop lngdp uhc i.reg if !missing(pov_spl), vce(robust)
  8.     putb `V' "comp.`v'.base_povsample" oop
  9.     regress `v' oop lngdp uhc pov_spl i.reg, vce(robust)
 10.     putb `V' "comp.`v'.spl" oop
 11.     putb `V' "comp.`v'.spl_pov" pov_spl
 12.     regress `v' oop lngdp uhc pov_ipl i.reg, vce(robust)
 13.     putb `V' "comp.`v'.ipl" oop
 14. }
