{com}. put `V' "threshold.check_regress" (_b[h]/_se[h])^2
{txt}
{com}. drop h
{txt}
{com}. * wild bootstrap under the linear null (Rademacher weights)
. quietly regress cat10 oop lngdp uhc i.reg
{txt}
{com}. predict double fit, xb
{txt}
{com}. predict double res, residuals
{txt}
{com}. local reps = 499
{txt}
{com}. mata:
{txt}{hline 49} mata (type {cmd:end} to exit) {hline}
{com}: f  = st_data(., "fit")
{res}
{com}: u  = st_data(., "res")
{res}
{com}: w0 = st_numscalar("W0")
{res}
{com}: ex = 0
{res}
{com}: for (r = 1; r <= `reps'; r++) {c -(}
>     ys = f + u :* (2 * (runiform(rows(u), 1) :< 0.5) :- 1)
>     rr = supw(ys, X0, o, 8)
>     if (rr[1] >= w0) ex++
> {c )-}
{res}
{com}: st_numscalar("exceed", ex)
{res}
{com}: end
{txt}{hline}

{com}. put `V' "threshold.p_boot" exceed/`reps'
{txt}
{com}. put `V' "threshold.reps" `reps'
{txt}
{com}. foreach c in 10 15 20 {c -(}
{txt}  2{com}.     capture drop h
{txt}  3{com}.     gen h = max(oop - `c', 0)
{txt}  4{com}.     regress cat10 oop h lngdp uhc i.reg, vce(robust)
{txt}  5{com}.     putb `V' "threshold.h`c'" h
{txt}  6{com}. {c )-}

