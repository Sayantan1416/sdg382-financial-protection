. *------------------------------------------------------------------------------
. * 1. LEVELS: latest survey since 2005, per measure; Bangladesh value and rank
. *------------------------------------------------------------------------------
. foreach v in cat10 cat25 fh_total fh_impov fh_large {c -(}
{txt}  2{com}.     use `S', clear
{txt}  3{com}.     keep if !missing(`v')
{txt}  4{com}.     bysort iso3 (svy_year): keep if _n == _N
{txt}  5{com}.     count
{txt}  6{com}.     put `V' "levels.`v'.n" r(N)
{txt}  7{com}.     local n = r(N)
{txt}  8{com}.     summarize `v', detail
{txt}  9{com}.     put `V' "levels.`v'.median" r(p50)
{txt} 10{com}.     summarize svy_year, detail
{txt} 11{com}.     put `V' "levels.`v'.median_year" r(p50)
{txt} 12{com}.     egen rk = rank(`v'), field
{txt} 13{com}.     summarize `v' if iso3 == "BGD"
{txt} 14{com}.     put `V' "levels.`v'.bgd" r(mean)
{txt} 15{com}.     summarize svy_year if iso3 == "BGD"
{txt} 16{com}.     put `V' "levels.`v'.bgd_year" r(mean)
{txt} 17{com}.     summarize rk if iso3 == "BGD"
{txt} 18{com}.     put `V' "levels.`v'.bgd_rank" r(mean)
{txt} 19{com}.     * Bangladesh 2016 value ranked against every other country's latest survey
.     preserve
{txt} 20{com}.         use `S', clear
{txt} 21{com}.         summarize `v' if iso3 == "BGD" & svy_year == 2016
{txt} 22{com}.         local b16 = r(mean)
{txt} 23{com}.     restore
{txt} 24{com}.     put `V' "bgd2016.`v'" `b16'
{txt} 25{com}.     count if `v' > `b16' & iso3 != "BGD"
{txt} 26{com}.     put `V' "bgd2016_rank.`v'.rank" r(N) + 1
{txt} 27{com}.     put `V' "bgd2016_rank.`v'.n" `n'
{txt} 28{com}. {c )-}
