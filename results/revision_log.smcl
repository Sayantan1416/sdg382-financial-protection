{com}. 
. *------------------------------------------------------------------------------
. * 6. THRESHOLD TESTS (Design A sample, n with complete controls)
. *------------------------------------------------------------------------------
. use `dA', clear
{txt}(Financial protection survey points, national totals)

{com}. count
  {res}107
{txt}
{com}. put `V' "threshold.n" r(N)
{txt}
{com}. count if oop < 20
  {res}18
{txt}
{com}. put `V' "threshold.n_below20" r(N)
{txt}
{com}. 
. * sup-Wald over break points 10-70% (each side at least 8 countries).
. * Computed in Mata: OLS with HC1 robust variance, identical to
. * "regress cat10 oop h lngdp uhc i.reg, vce(robust)" for each break point,
. * but fast enough for the bootstrap (499 x 61 regressions in seconds).
. capture mata: mata drop supw()
{txt}
{com}. mata:
{txt}{hline 49} mata (type {cmd:end} to exit) {hline}
{com}: real rowvector supw(real colvector y, real matrix X0, real colvector oop, real scalar minn)
> {c -(}
>     real scalar best, at, c, k, n, w
>     real colvector h, b, e
>     real matrix X, XXi, V
>     best = 0
>     at = .
>     n = rows(y)
>     for (c = 10; c <= 70; c++) {c -(}
>         h = (oop :- c) :* (oop :> c)
>         if (sum(h :> 0) < minn | sum(h :== 0) < minn) continue
>         X   = (X0, h)
>         XXi = invsym(cross(X, X))
>         b   = XXi * cross(X, y)
>         e   = y - X * b
>         k   = sum(diagonal(XXi) :!= 0)
>         V   = XXi * cross(X, e:^2, X) * XXi * (n / (n - k))
>         w   = b[cols(X)]^2 / V[cols(X), cols(X)]
>         if (w > best) {c -(}
>             best = w
>             at = c
>         {c )-}
>     {c )-}
>     return((best, at))
> {c )-}

: end
{txt}{hline}

{com}. quietly tab reg, gen(rd_)
{txt}
{com}. drop rd_1
{txt}
{com}. gen byte cons = 1
{txt}
{com}. mata: y = st_data(., "cat10"); X0 = st_data(., "oop lngdp uhc rd_* cons"); o = st_data(., "oop")
{res}{txt}
{com}. mata: r0 = supw(y, X0, o, 8); st_numscalar("W0", r0[1]); st_numscalar("at0", r0[2])
{res}{txt}
{com}. put `V' "threshold.supW" W0
{txt}
{com}. put `V' "threshold.at" at0
{txt}
{com}. * check: the same statistic from regress at the chosen break point
. gen h = max(oop - at0, 0)
{txt}
{com}. regress cat10 oop h lngdp uhc i.reg, vce(robust)

