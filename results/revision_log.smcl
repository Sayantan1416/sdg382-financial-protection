{com}. 
. * put <postname> "<key>" <expression>   (the expression may contain spaces)
. cap program drop put
{txt}
{com}. program define put
{txt}  1{com}.     gettoken h 0 : 0
{txt}  2{com}.     gettoken key 0 : 0
{txt}  3{com}.     post `h' ("`key'") (`0')
{txt}  4{com}. end
{txt}
{com}. 
. * post b, p, lo, hi, n for one term of the last model (uses r(table))
. cap program drop putb
{txt}
{com}. program define putb
{txt}  1{com}.     args h key term
{txt}  2{com}.     tempname rt
{txt}  3{com}.     matrix `rt' = r(table)
{txt}  4{com}.     local c = colnumb(`rt', "`term'")
{txt}  5{com}.     post `h' ("`key'.b")  (`rt'[1,`c'])
{txt}  6{com}.     post `h' ("`key'.p")  (`rt'[4,`c'])
{txt}  7{com}.     post `h' ("`key'.lo") (`rt'[5,`c'])
{txt}  8{com}.     post `h' ("`key'.hi") (`rt'[6,`c'])
{txt}  9{com}.     post `h' ("`key'.n")  (e(N))
{txt} 10{com}. end
{txt}
{com}. 
. * attach to every row the panel value of `v' from the year nearest to svy_year
. * (within +/- 2 years; exact year wins, then the earlier year) -- one row per
. * country-survey, so this works for files with several surveys per country
. cap program drop nearest2
{txt}
{com}. program define nearest2
{txt}  1{com}.     args v
{txt}  2{com}.     tempvar row
{txt}  3{com}.     gen long `row' = _n
{txt}  4{com}.     preserve
{txt}  5{com}.         use iso3 year `v' using "$in/panel.dta", clear
{txt}  6{com}.         drop if missing(`v')
{txt}  7{com}.         rename year y_`v'
{txt}  8{com}.         tempfile t
{txt}  9{com}.         save `t'
{txt} 10{com}.     restore
{txt} 11{com}.     joinby iso3 using `t', unmatched(master)
{txt} 12{com}.     gen double d_`v' = abs(y_`v' - svy_year)
{txt} 13{com}.     bysort `row' (d_`v' y_`v'): keep if _n == 1
{txt} 14{com}.     replace `v' = . if missing(d_`v') | d_`v' > 2
{txt} 15{com}.     drop _merge d_`v' y_`v' `row'
{txt} 16{com}. end
{txt}
{com}. 
