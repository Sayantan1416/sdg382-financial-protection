{com}. * efficiency (residual) against hardship under each indicator
. foreach v in cat10 fh_total {c -(}
{txt}  2{com}.     use `S', clear
{txt}  3{com}.     keep if !missing(`v')
{txt}  4{com}.     bysort iso3 (svy_year): keep if _n == _N
{txt}  5{com}.     merge 1:1 iso3 using `Bres', keep(match) nogen
{txt}  6{com}.     count
{txt}  7{com}.     put `V' "eff.`v'.n" r(N)
{txt}  8{com}.     spearman res `v'
{txt}  9{com}.     put `V' "eff.`v'.rho" r(rho)
{txt} 10{com}.     spearman res_g `v'
{txt} 11{com}.     put `V' "eff.`v'.rho_g" r(rho)
{txt} 12{com}.     summarize `v', detail
{txt} 13{com}.     local m = r(p50)
{txt} 14{com}.     put `V' "eff.`v'.median" `m'
{txt} 15{com}.     count if res > 3 & `v' < `m'
{txt} 16{com}.     put `V' "eff.`v'.over_low" r(N)
{txt} 17{com}.     count if res > 3 & `v' >= `m'
{txt} 18{com}.     put `V' "eff.`v'.over_high" r(N)
{txt} 19{com}. {c )-}
