. *----------------------------------------------------------------------------
> --
. * 1. LEVELS: latest survey since 2005, per measure; Bangladesh value and rank
. *----------------------------------------------------------------------------
> --
. foreach v in cat10 cat25 fh_total fh_impov fh_large {
  2.     use `S', clear
  3.     keep if !missing(`v')
  4.     bysort iso3 (svy_year): keep if _n == _N
  5.     count
  6.     put `V' "levels.`v'.n" r(N)
  7.     local n = r(N)
  8.     summarize `v', detail
  9.     put `V' "levels.`v'.median" r(p50)
 10.     summarize svy_year, detail
 11.     put `V' "levels.`v'.median_year" r(p50)
 12.     egen rk = rank(`v'), field
 13.     summarize `v' if iso3 == "BGD"
 14.     put `V' "levels.`v'.bgd" r(mean)
 15.     summarize svy_year if iso3 == "BGD"
 16.     put `V' "levels.`v'.bgd_year" r(mean)
 17.     summarize rk if iso3 == "BGD"
 18.     put `V' "levels.`v'.bgd_rank" r(mean)
 19.     * Bangladesh 2016 value ranked against every other country's latest su
> rvey
.     preserve
 20.         use `S', clear
 21.         summarize `v' if iso3 == "BGD" & svy_year == 2016
 22.         local b16 = r(mean)
 23.     restore
 24.     put `V' "bgd2016.`v'" `b16'
 25.     count if `v' > `b16' & iso3 != "BGD"
 26.     put `V' "bgd2016_rank.`v'.rank" r(N) + 1
 27.     put `V' "bgd2016_rank.`v'.n" `n'
 28. }
