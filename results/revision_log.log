. local reps = 499

. mata:
------------------------------------------------- mata (type end to exit) -----
: f  = st_data(., "fit")

: u  = st_data(., "res")

: w0 = st_numscalar("W0")

: ex = 0

: for (r = 1; r <= `reps'; r++) {
>     ys = f + u :* (2 * (runiform(rows(u), 1) :< 0.5) :- 1)
>     rr = supw(ys, X0, o, 8)
>     if (rr[1] >= w0) ex++
> }

: st_numscalar("exceed", ex)

: end
