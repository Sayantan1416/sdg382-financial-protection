. 
. * put <postname> "<key>" <expression>   (the expression may contain spaces)
. cap program drop put

. program define put
  1.     gettoken h 0 : 0
  2.     gettoken key 0 : 0
  3.     post `h' ("`key'") (`0')
  4. end

. 
. * post b, p, lo, hi, n for one term of the last model (uses r(table))
. cap program drop putb

. program define putb
  1.     args h key term
  2.     tempname rt
  3.     matrix `rt' = r(table)
  4.     local c = colnumb(`rt', "`term'")
  5.     post `h' ("`key'.b")  (`rt'[1,`c'])
  6.     post `h' ("`key'.p")  (`rt'[4,`c'])
  7.     post `h' ("`key'.lo") (`rt'[5,`c'])
  8.     post `h' ("`key'.hi") (`rt'[6,`c'])
  9.     post `h' ("`key'.n")  (e(N))
 10. end

. 
. * attach to every row the panel value of `v' from the year nearest to svy_yea
> r
. * (within +/- 2 years; exact year wins, then the earlier year) -- one row per
. * country-survey, so this works for files with several surveys per country
. cap program drop nearest2

. program define nearest2
  1.     args v
  2.     tempvar row
  3.     gen long `row' = _n
  4.     preserve
  5.         use iso3 year `v' using "$in/panel.dta", clear
  6.         drop if missing(`v')
  7.         rename year y_`v'
  8.         tempfile t
  9.         save `t'
 10.     restore
 11.     joinby iso3 using `t', unmatched(master)
 12.     gen double d_`v' = abs(y_`v' - svy_year)
 13.     bysort `row' (d_`v' y_`v'): keep if _n == 1
 14.     replace `v' = . if missing(d_`v') | d_`v' > 2
 15.     drop _merge d_`v' y_`v' `row'
 16. end

