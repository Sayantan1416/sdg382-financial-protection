. * efficiency (residual) against hardship under each indicator
. foreach v in cat10 fh_total {
  2.     use `S', clear
  3.     keep if !missing(`v')
  4.     bysort iso3 (svy_year): keep if _n == _N
  5.     merge 1:1 iso3 using `Bres', keep(match) nogen
  6.     count
  7.     put `V' "eff.`v'.n" r(N)
  8.     spearman res `v'
  9.     put `V' "eff.`v'.rho" r(rho)
 10.     spearman res_g `v'
 11.     put `V' "eff.`v'.rho_g" r(rho)
 12.     summarize `v', detail
 13.     local m = r(p50)
 14.     put `V' "eff.`v'.median" `m'
 15.     count if res > 3 & `v' < `m'
 16.     put `V' "eff.`v'.over_low" r(N)
 17.     count if res > 3 & `v' >= `m'
 18.     put `V' "eff.`v'.over_high" r(N)
 19. }
