{res}{txt}
{com}. * --- group gaps ---
. foreach g in gap_q gap_old gap_rur {c -(}
{txt}  2{com}.     use `G', clear
{txt}  3{com}.     keep if !missing(`g')
{txt}  4{com}.     bysort iso3 (svy_year): keep if _n == _N
{txt}  5{com}.     keep if !missing(`g', oop, lngdp)
{txt}  6{com}.     regress `g' oop lngdp
{txt}  7{com}.     predict double cd, cooksd
{txt}  8{com}.     regress `g' oop lngdp if cd <= 4/e(N), vce(robust)
{txt}  9{com}.     putb `V' "alt.`g'.cook" oop
{txt} 10{com}.     qreg `g' oop lngdp, vce(robust)
{txt} 11{com}.     putb `V' "alt.`g'.qreg" oop
{txt} 12{com}.     * ratio instead of difference (relative gap)
.     if "`g'" == "gap_q"   gen double rel = ln(q1/q5)     if q5 > 0 & q1 > 0
{txt} 13{com}.     if "`g'" == "gap_old" gen double rel = ln(old/adults) if adults > 0 & old > 0
{txt} 14{com}.     if "`g'" == "gap_rur" gen double rel = ln(rur/urb)   if urb > 0 & rur > 0
{txt} 15{com}.     regress rel oop lngdp, vce(robust)
{txt} 16{com}.     putb `V' "alt.`g'.ln_ratio" oop
{txt} 17{com}. {c )-}
