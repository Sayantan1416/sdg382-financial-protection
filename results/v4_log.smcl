{com}. 
. *------------------------------------------------------------------------------
. * 4. SENSITIVITY
. *------------------------------------------------------------------------------
. * 4a. matching window (+/-0, 1, 2, 3 years)
. foreach k in 0 1 2 3 {c -(}
{txt}  2{com}.     build_S `k' `L' `H'
{txt}  3{com}.     tempfile Sk
{txt}  4{com}.     save `Sk'
{txt}  5{com}.     keep if !missing(cat10)
{txt}  6{com}.     bysort iso3 (svy_year): keep if _n == _N
{txt}  7{com}.     regress cat10 oop lngdp uhc i.reg, vce(robust)
{txt}  8{com}.     putb `V' "win`k'.A" oop
{txt}  9{com}.     use `Sk', clear
{txt} 10{com}.     keep if !missing(cat10, fh_total)
{txt} 11{com}.     bysort iso3 (svy_year): keep if _n == _N
{txt} 12{com}.     keep if !missing(lngdp)
{txt} 13{com}.     spearman fh_total lngdp
{txt} 14{com}.     put `V' "win`k'.rho_new" r(rho)
{txt} 15{com}.     spearman cat10 lngdp
{txt} 16{com}.     put `V' "win`k'.rho_old" r(rho)
{txt} 17{com}.     expand 2
{txt} 18{com}.     bysort iso3: gen byte new = _n == 2
{txt} 19{com}.     gen y = cond(new, fh_total, cat10)
{txt} 20{com}.     regress y i.new##c.lngdp i.new##i.reg, vce(cluster cid)
{txt} 21{com}.     put `V' "win`k'.diff_b" -_b[1.new#c.lngdp]
{txt} 22{com}.     put `V' "win`k'.diff_p" 2*ttail(e(df_r), abs(_b[1.new#c.lngdp]/_se[1.new#c.lngdp]))
{txt} 23{com}.     put `V' "win`k'.diff_n" e(N)/2
{txt} 24{com}.     build_G `k' `L'
{txt} 25{com}.     tempfile Gk
{txt} 26{com}.     save `Gk'
{txt} 27{com}.     foreach g in gap_q gap_old gap_rur {c -(}
{txt} 28{com}.         use `Gk', clear
{txt} 29{com}.         keep if !missing(`g')
{txt} 30{com}.         bysort iso3 (svy_year): keep if _n == _N
{txt} 31{com}.         regress `g' oop lngdp, vce(robust)
{txt} 32{com}.         putb `V' "win`k'.`g'" oop
{txt} 33{com}.         regress `g' oop lngdp pov_spl, vce(robust)
{txt} 34{com}.         putb `V' "win`k'.`g'_pov" oop
{txt} 35{com}.     {c )-}
{txt} 36{com}. {c )-}
