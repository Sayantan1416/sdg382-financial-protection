{com}. 
. * 4e. threshold reassessment on the 2025 indicator (pairs with controls)
. capture mata: mata drop supw()
{txt}
{com}. capture mata: mata drop wboot()
{txt}
{com}. mata:
{txt}{hline 49} mata (type {cmd:end} to exit) {hline}
{com}: real rowvector supw(real colvector y, real matrix X0, real colvector oop, real scalar minn)
> {c -(}
>     real scalar best, at, c, k, n, w
>     real colvector h, b, e
>     real matrix X, XXi, V
>     best = 0
>     at = .
>     n = rows(y)
>     for (c = 10; c <= 70; c++) {c -(}
>         h = (oop :- c) :* (oop :> c)
>         if (sum(h :> 0) < minn | sum(h :== 0) < minn) continue
>         X   = (X0, h)
>         XXi = invsym(cross(X, X))
>         b   = XXi * cross(X, y)
>         e   = y - X * b
>         k   = sum(diagonal(XXi) :!= 0)
>         V   = XXi * cross(X, e:^2, X) * XXi * (n / (n - k))
>         w   = b[cols(X)]^2 / V[cols(X), cols(X)]
>         if (w > best) {c -(}
>             best = w
>             at = c
>         {c )-}
>     {c )-}
>     return((best, at))
> {c )-}

: real scalar wboot(real colvector f, real colvector u, real matrix X0, real colvector o, real scalar w0, real scalar reps)
> {c -(}
>     real scalar r, ex
>     real colvector ys
>     real rowvector rr
>     ex = 0
>     for (r = 1; r <= reps; r++) {c -(}
>         ys = f + u :* (2 * (runiform(rows(u), 1) :< 0.5) :- 1)
>         rr = supw(ys, X0, o, 8)
>         if (rr[1] >= w0) ex++
>     {c )-}
>     return(ex)
> {c )-}

: end
{txt}{hline}

{com}. foreach spec in base pov {c -(}
{txt}  2{com}.     use `S', clear
{txt}  3{com}.     keep if !missing(fh_total)
{txt}  4{com}.     bysort iso3 (svy_year): keep if _n == _N
{txt}  5{com}.     local ctl "lngdp uhc"
{txt}  6{com}.     if "`spec'" == "pov" local ctl "lngdp uhc pov_spl"
{txt}  7{com}.     keep if !missing(fh_total, oop, reg) & !missing(`=subinstr("`ctl'", " ", ",", .)')
{txt}  8{com}.     count
{txt}  9{com}.     put `V' "thr_new.`spec'.n" r(N)
{txt} 10{com}.     quietly tab reg, gen(rd_)
{txt} 11{com}.     drop rd_1
{txt} 12{com}.     gen byte cons = 1
{txt} 13{com}.     mata: y = st_data(., "fh_total"); X0 = st_data(., "oop `ctl' rd_* cons"); o = st_data(., "oop")
{txt} 14{com}.     mata: r0 = supw(y, X0, o, 8); st_numscalar("W0", r0[1]); st_numscalar("at0", r0[2])
{txt} 15{com}.     put `V' "thr_new.`spec'.supW" W0
{txt} 16{com}.     put `V' "thr_new.`spec'.at" at0
{txt} 17{com}.     quietly regress fh_total oop `ctl' i.reg
{txt} 18{com}.     predict double fit, xb
{txt} 19{com}.     predict double res, residuals
{txt} 20{com}.     mata: st_numscalar("exceed", wboot(st_data(., "fit"), st_data(., "res"), X0, o, st_numscalar("W0"), 499))
{txt} 21{com}.     put `V' "thr_new.`spec'.p_boot" exceed/499
{txt} 22{com}.     gen oop2 = oop^2
{txt} 23{com}.     regress fh_total oop oop2 `ctl' i.reg, vce(robust)
{txt} 24{com}.     putb `V' "thr_new.`spec'.quad" oop2
{txt} 25{com}.     capture drop h
{txt} 26{com}.     gen h = max(oop - 20, 0)
{txt} 27{com}.     regress fh_total oop h `ctl' i.reg, vce(robust)
{txt} 28{com}.     putb `V' "thr_new.`spec'.h20" h
{txt} 29{com}. {c )-}
