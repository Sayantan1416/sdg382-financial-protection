. cap program drop build_G

. program define build_G
  1.     args k L
  2.     import delimited using "$in/$hard", clear varnames(1) case(lower) stri
> ngcols(_all)
  3.     keep spatialdim timedim dim1 dim2 numericvalue
  4.     destring timedim numericvalue, replace
  5.     rename spatialdim iso3
  6.     rename timedim svy_year
  7.     merge m:1 iso3 using `L', keep(match) nogen keepusing(iso3)
  8.     keep if svy_year >= 2005
  9.     gen g = ""
 10.     replace g = "q1"     if dim1 == "WEALTHQUINTILE_WQ1"
 11.     replace g = "q5"     if dim1 == "WEALTHQUINTILE_WQ5"
 12.     replace g = "old"    if dim1 == "HOUSEHOLD_COMP_BY_AGE_HH_COMP_ONLY_OL
> DER_ADULTS"
 13.     replace g = "adults" if dim1 == "HOUSEHOLD_COMP_BY_AGE_HH_COMP_ADULTS"
 14.     replace g = "rur"    if dim1 == "RESIDENCEAREATYPE_RUR"
 15.     replace g = "urb"    if dim1 == "RESIDENCEAREATYPE_URB"
 16.     replace g = "tot"    if dim1 == "FINANCIALHARDSHIPCOMPONENT_COMPONENT_
> TOTAL"
 17.     keep if g != ""
 18.     collapse (mean) numericvalue, by(iso3 svy_year g)
 19.     reshape wide numericvalue, i(iso3 svy_year) j(g) string
 20.     rename numericvalue* *
 21.     gen gap_q   = q1 - q5
 22.     gen gap_old = old - adults
 23.     gen gap_rur = rur - urb
 24.     merge m:1 iso3 using `L', keep(match) nogen
 25.     foreach v in oop gdp_ppp uhc pov_spl pov_ipl pop65 {
 26.         nearestk `v' `k'
 27.     }
 28.     gen lngdp = ln(gdp_ppp)
 29. end

