. cap program drop put

. program define put
  1.     gettoken h 0 : 0
  2.     gettoken key 0 : 0
  3.     post `h' ("`key'") (`0')
  4. end

. cap program drop putb

. program define putb
  1.     args h key term
  2.     tempname rt
  3.     matrix `rt' = r(table)
  4.     local c = colnumb(`rt', "`term'")
  5.     post `h' ("`key'.b")  (`rt'[1,`c'])
  6.     post `h' ("`key'.p")  (`rt'[4,`c'])
  7.     post `h' ("`key'.lo") (`rt'[5,`c'])
  8.     post `h' ("`key'.hi") (`rt'[6,`c'])
  9.     post `h' ("`key'.n")  (e(N))
 10. end

. * nearestk v k : attach the panel_v4 value of v from the year nearest svy_yea
> r,
. * within +/- k years (exact year first, then the earlier year)
. cap program drop nearestk

. program define nearestk
  1.     args v k
  2.     tempvar row
  3.     gen long `row' = _n
  4.     preserve
  5.         use iso3 year `v' using "$out/panel_v4.dta", clear
  6.         drop if missing(`v')
  7.         rename year y_`v'
  8.         tempfile t
  9.         save `t'
 10.     restore
 11.     capture drop `v'
 12.     joinby iso3 using `t', unmatched(master)
 13.     gen double d_`v' = abs(y_`v' - svy_year)
 14.     bysort `row' (d_`v' y_`v'): keep if _n == 1
 15.     replace `v' = . if missing(d_`v') | d_`v' > `k'
 16.     gen byte dist_`v' = d_`v' if !missing(`v')
 17.     drop _merge d_`v' y_`v' `row'
 18. end

