. 
. * post one coefficient from the last model
. cap program drop post_b

. program define post_b
  1.     args h section model term
  2.     local b  = _b[`term']
  3.     local se = _se[`term']
  4.     if !missing(e(df_r)) local p = 2*ttail(e(df_r), abs(`b'/`se'))
  5.     else                 local p = 2*normal(-abs(`b'/`se'))
  6.     post `h' ("`section'") ("`model'") ("`term'") (`b') (`se') (`p') (e(N)
> ) (e(r2))
  7. end

. 
. * post one number
. cap program drop post_n

. program define post_n
  1.     args h section item value
  2.     post `h' ("`section'") ("`item'") (`value')
  3. end

. 
. * attach, for each country, the value of `v' from the panel year nearest to
. * the survey year (svy_year), within +/- 2 years; exact year wins, then earli
> er
. cap program drop nearest

. program define nearest
  1.     args v
  2.     preserve
  3.         use iso3 year `v' using "$in/panel.dta", clear
  4.         drop if missing(`v')
  5.         rename year y_`v'
  6.         tempfile t
  7.         save `t'
  8.     restore
  9.     joinby iso3 using `t', unmatched(master)
 10.     gen double d_`v' = abs(y_`v' - svy_year)
 11.     bysort iso3 (d_`v' y_`v'): keep if _n == 1
 12.     replace `v' = . if missing(d_`v') | d_`v' > 2
 13.     drop _merge d_`v' y_`v'
 14. end

