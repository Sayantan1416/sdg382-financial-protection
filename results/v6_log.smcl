. * --- reproduction checks against the stored v3/v4 results --------------------
. preserve
{txt}
{com}.     import delimited using "$out/results_v4.csv", clear varnames(1) asdouble
{res}{txt}(encoding automatically selected: ISO-8859-1)
{text}(2 vars, 812 obs)

{com}.     quietly summarize value if key == "pov.gap_q.spl.b"
{txt}
{com}.     assert reldif(r(mean), `chk_abs') < 1e-8
{txt}
{com}.     quietly summarize value if key == "alt.gap_q.ln_ratio.b"
{txt}
{com}.     assert reldif(r(mean), `chk_ratio') < 1e-8
{txt}
{com}.     import delimited using "$out/results_v3.csv", clear varnames(1) asdouble
{res}{txt}(encoding automatically selected: ISO-8859-1)
{text}(2 vars, 379 obs)

{com}.     quietly summarize value if key == "B.lnche_gdp"
{txt}
{com}.     assert reldif(r(mean), `chk_B') < 1e-8
{txt}
{com}. restore
{txt}
{com}. di as result "Reproduction checks passed (v4 gap, v4 ratio, v3 Design B)."
{res}Reproduction checks passed (v4 gap, v4 ratio, v3 Design B).
{txt}
{com}. 
. postclose `V'
