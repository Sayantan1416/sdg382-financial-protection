. * --- RQ2: 2019 life expectancy on ln spending with ln GDP (05, Design B) -------
. use "$in/panel.dta", clear
{txt}(LMIC panel 2000-2023, WDI + WHO GHO)

{com}. keep if year == 2019
{txt}(3,013 observations deleted)

{com}. merge m:1 iso3 using `L', keep(match) nogen
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}               0
{txt}{col 5}Matched{col 30}{res}             131{txt}  
{col 5}{hline 41}

{com}. gen lnche = ln(che_ppp)
{txt}(2 missing values generated)

{com}. gen lngdp = ln(gdp_ppp)
{txt}(6 missing values generated)

