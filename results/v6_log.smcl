{com}. 
. cap program drop build_G
{txt}
{com}. program define build_G
{txt}  1{com}.     args k L
{txt}  2{com}.     import delimited using "$in/$hard", clear varnames(1) case(lower) stringcols(_all)
{txt}  3{com}.     keep spatialdim timedim dim1 dim2 numericvalue
{txt}  4{com}.     destring timedim numericvalue, replace
{txt}  5{com}.     rename spatialdim iso3
{txt}  6{com}.     rename timedim svy_year
{txt}  7{com}.     merge m:1 iso3 using `L', keep(match) nogen keepusing(iso3)
{txt}  8{com}.     keep if svy_year >= 2005
{txt}  9{com}.     gen g = ""
{txt} 10{com}.     replace g = "q1"     if dim1 == "WEALTHQUINTILE_WQ1"
{txt} 11{com}.     replace g = "q5"     if dim1 == "WEALTHQUINTILE_WQ5"
{txt} 12{com}.     replace g = "old"    if dim1 == "HOUSEHOLD_COMP_BY_AGE_HH_COMP_ONLY_OLDER_ADULTS"
{txt} 13{com}.     replace g = "adults" if dim1 == "HOUSEHOLD_COMP_BY_AGE_HH_COMP_ADULTS"
{txt} 14{com}.     replace g = "rur"    if dim1 == "RESIDENCEAREATYPE_RUR"
{txt} 15{com}.     replace g = "urb"    if dim1 == "RESIDENCEAREATYPE_URB"
{txt} 16{com}.     replace g = "tot"    if dim1 == "FINANCIALHARDSHIPCOMPONENT_COMPONENT_TOTAL"
{txt} 17{com}.     keep if g != ""
{txt} 18{com}.     collapse (mean) numericvalue, by(iso3 svy_year g)
{txt} 19{com}.     reshape wide numericvalue, i(iso3 svy_year) j(g) string
{txt} 20{com}.     rename numericvalue* *
{txt} 21{com}.     gen gap_q   = q1 - q5
{txt} 22{com}.     gen gap_old = old - adults
{txt} 23{com}.     gen gap_rur = rur - urb
{txt} 24{com}.     merge m:1 iso3 using `L', keep(match) nogen
{txt} 25{com}.     foreach v in oop gdp_ppp uhc pov_spl pov_ipl pop65 {c -(}
{txt} 26{com}.         nearestk `v' `k'
{txt} 27{com}.     {c )-}
{txt} 28{com}.     gen lngdp = ln(gdp_ppp)
{txt} 29{com}. end
{txt}
{com}. 
. 
