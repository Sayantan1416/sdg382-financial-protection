. *------------------------------------------------------------------------------
. * 4. ANALYSIS C -- WITHIN-COUNTRY PANEL 2000-2019 (two-way FE, clustered SE)
. *------------------------------------------------------------------------------
. use "$in/panel.dta" if inrange(year, 2000, 2019), clear
{txt}(LMIC panel 2000-2023, WDI + WHO GHO)

{com}. encode iso3, gen(cid)
{txt}
{com}. xtset cid year
{res}
{col 1}{txt:Panel variable: }{res:cid}{txt: (strongly balanced)}
{p 1 16 2}{txt:Time variable: }{res:year}{txt:, }{res:{bind:2000}}{txt: to }{res:{bind:2019}}{p_end}
{txt}{col 10}Delta: {res}1 unit
{txt}
{com}. gen lnu5      = ln(u5mr)
{txt}
{com}. gen lnche     = ln(che_ppp)                    // current PPP (as in abstract)
{txt}(118 missing values generated)

{com}. gen lnche_k   = ln(che_gdp/100 * gdp_ppp)      // constant 2021 PPP
{txt}(195 missing values generated)

{com}. gen lngdp     = ln(gdp_ppp)
{txt}(141 missing values generated)

{com}. label var lnche   "ln CHE pc (current PPP)"
{txt}
{com}. label var lnche_k "ln CHE pc (constant PPP)"
{txt}
{com}. 
. eststo clear
{txt}
{com}. eststo C1: reghdfe lnu5 lnche, absorb(cid year) vce(cluster cid)
