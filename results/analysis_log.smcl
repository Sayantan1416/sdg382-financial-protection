{com}. postfile `N' str4 section str60 item double value ///
>     using "$out/results_numeric.dta", replace
{txt}{p 0 4 2}
(file {bf}
C:\Stata\fresh_test_v6\20.11.26_Financial_Protection_v6/output/results_numeric.dta{rm}
not found)
{p_end}

{com}. 
. * post one coefficient from the last model
. cap program drop post_b
{txt}
{com}. program define post_b
{txt}  1{com}.     args h section model term
{txt}  2{com}.     local b  = _b[`term']
{txt}  3{com}.     local se = _se[`term']
{txt}  4{com}.     if !missing(e(df_r)) local p = 2*ttail(e(df_r), abs(`b'/`se'))
{txt}  5{com}.     else                 local p = 2*normal(-abs(`b'/`se'))
{txt}  6{com}.     post `h' ("`section'") ("`model'") ("`term'") (`b') (`se') (`p') (e(N)) (e(r2))
{txt}  7{com}. end
{txt}
{com}. 
. * post one number
. cap program drop post_n
{txt}
{com}. program define post_n
{txt}  1{com}.     args h section item value
{txt}  2{com}.     post `h' ("`section'") ("`item'") (`value')
{txt}  3{com}. end
{txt}
{com}. 
. * attach, for each country, the value of `v' from the panel year nearest to
. * the survey year (svy_year), within +/- 2 years; exact year wins, then earlier
. cap program drop nearest
{txt}
{com}. program define nearest
{txt}  1{com}.     args v
{txt}  2{com}.     preserve
{txt}  3{com}.         use iso3 year `v' using "$in/panel.dta", clear
{txt}  4{com}.         drop if missing(`v')
{txt}  5{com}.         rename year y_`v'
{txt}  6{com}.         tempfile t
{txt}  7{com}.         save `t'
{txt}  8{com}.     restore
{txt}  9{com}.     joinby iso3 using `t', unmatched(master)
{txt} 10{com}.     gen double d_`v' = abs(y_`v' - svy_year)
{txt} 11{com}.     bysort iso3 (d_`v' y_`v'): keep if _n == 1
{txt} 12{com}.     replace `v' = . if missing(d_`v') | d_`v' > 2
{txt} 13{com}.     drop _merge d_`v' y_`v'
{txt} 14{com}. end
{txt}
{com}. 
. *------------------------------------------------------------------------------
. * 1. SAMPLE COUNTS
. *------------------------------------------------------------------------------
. use "$in/panel.dta", clear
{txt}(LMIC panel 2000-2023, WDI + WHO GHO)

{com}. quietly levelsof iso3, local(all)
{txt}
{com}. post_n `N' "S" "LMICs (FY2027)" `: word count `all''
{txt}
{com}. foreach g in LIC LMC UMC {c -(}
{txt}  2{com}.     quietly levelsof iso3 if income == "`g'", local(x)
{txt}  3{com}.     post_n `N' "S" "LMICs `g'" `: word count `x''
{txt}  4{com}. {c )-}
{txt}
{com}. 
. *------------------------------------------------------------------------------
. * 2. ANALYSIS A -- FINANCIAL PROTECTION (one row per country)
. *    Outcome: % population with OOP > 10% (25%) of budget, latest survey >=2005
. *    Exposures/controls: measured in the survey year (+/- 2 years)
. *------------------------------------------------------------------------------
. use "$in/fp_surveys.dta", clear
{txt}(Financial protection survey points, national totals)

{com}. keep if !missing(cat10) & year >= 2005
{txt}(305 observations deleted)

{com}. bysort iso3 (year): keep if _n == _N
{txt}(364 observations deleted)

{com}. rename year svy_year
{res}{txt}
{com}. keep iso3 country region income svy_year cat10 cat25
{txt}
