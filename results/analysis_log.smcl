. * user-written packages (installed once from SSC)
. foreach p in ftools require reghdfe estout {c -(}
{txt}  2{com}.     cap which `p'
{txt}  3{com}.     if _rc ssc install `p', replace
{txt}  4{com}. {c )-}
{txt}
{com}. cap reghdfe, compile          // harmless if already compiled
{txt}
{com}. 
. * --- result files -------------------------------------------------------------
. tempname R N
{txt}
{com}. postfile `R' str4 section str40 model str24 term ///
>     double(b se p n r2) using "$out/results_estimates.dta", replace
{txt}{p 0 4 2}
