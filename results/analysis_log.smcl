{txt}  2{com}.     foreach v in le_who u5mr che_ppp oop uhc res_le res_le_gdp {c -(}
{txt}  3{com}.         summ `v' if iso3 == "`c'", meanonly
{txt}  4{com}.         post_n `N' "BD" "`c' `v' 2019" r(mean)
{txt}  5{com}.     {c )-}
{txt}  6{com}. {c )-}
{txt}
