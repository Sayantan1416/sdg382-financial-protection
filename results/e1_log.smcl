. *--- 2. same-survey pairs + half splits (rule of 05_revision_analysis.do) -------
. import delimited using "$out/pairs_same_survey.csv", clear varnames(1) case(lower)
{res}{txt}(encoding automatically selected: ISO-8859-1)
{text}(8 vars, 104 obs)

{com}. quietly summarize cat10, detail
{txt}
{com}. gen byte old_low  = cat10 < r(p50)
{txt}
{com}. quietly summarize fh_total, detail
{txt}
{com}. gen byte new_high = fh_total >= r(p50)
{txt}
{com}. * ln GDP per person matched to the SDG survey year (+/-2, exact, then earlier)
. gen long row = _n
{txt}
{com}. preserve
{txt}
{com}.     use iso3 year gdp_ppp using "$in/panel.dta", clear
{txt}(LMIC panel 2000-2023, WDI + WHO GHO)

{com}.     drop if missing(gdp_ppp)
{txt}(166 observations deleted)

{com}.     rename year y_g
{res}{txt}
{com}.     tempfile G
{txt}
{com}.     save `G'
{txt}{p 0 4 2}
file {bf}
C:\Users\<user>\AppData\Local\Temp\ST_5d30_000004.tmp{rm}
saved
as .dta format
{p_end}

{com}. restore
{txt}
{com}. joinby iso3 using `G', unmatched(master)
{txt}
{com}. gen d_g = abs(y_g - svy_year)
{txt}(2 missing values generated)

{com}. bysort row (d_g y_g): keep if _n == 1
{txt}(2,332 observations deleted)

{com}. replace gdp_ppp = . if missing(d_g) | d_g > 2
{txt}(0 real changes made)

{com}. gen lngdp = ln(gdp_ppp)
{txt}(2 missing values generated)

{com}. drop _merge d_g y_g
